<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Elio\ElioBatteryIncludedSearchExtension\Configuration\Subscriber\ConfigurationSubscriber">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="Elio\ElioBatteryIncludedSearchExtension\Configuration\Api\ConnectionTestController" public="true">
            <argument type="service" id="Elio\ElioBatteryIncludedSearchExtension\Api\Test\ConnectionTest"/>
            <argument type="service" id="sales_channel.repository" />
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>
</container>