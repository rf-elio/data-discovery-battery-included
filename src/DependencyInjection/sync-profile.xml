<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Elio\ElioBatteryIncludedSearchExtension\Core\Sync\BIProfile">
            <tag name="elio-data-discovery.sync.profile" />
        </service>
        <service id="Elio\ElioBatteryIncludedSearchExtension\Core\Sync\Output\BIOutput">
            <argument type="service" id="shopware.app_system.guzzle"/>
            <argument type="service" id="Elio\ElioBatteryIncludedSearchExtension\Core\Sync\Output\Service\BatteryIncludedService"/>
            <argument type="service" id="elio.data-discovery.core.logging.debug"/>
            <tag name="elio-data-discovery.sync.api.output" />
        </service>

        <!--   Services    -->
        <service id="Elio\ElioBatteryIncludedSearchExtension\Core\Sync\Output\Service\ProductMappingService"/>
        <service id="Elio\ElioBatteryIncludedSearchExtension\Core\Sync\Output\Service\ContentMappingService" />
        <service id="Elio\ElioBatteryIncludedSearchExtension\Core\Sync\Output\Service\BatteryIncludedService">
            <argument type="service" id="Elio\ElioDataDiscovery\Configuration\ElioDataDiscoveryConfigService"/>
            <argument type="service" id="Elio\ElioBatteryIncludedSearchExtension\Core\Sync\Output\Service\ProductMappingService"/>
            <argument type="service" id="Elio\ElioBatteryIncludedSearchExtension\Core\Sync\Output\Service\ContentMappingService"/>
        </service>
    </services>
</container>
