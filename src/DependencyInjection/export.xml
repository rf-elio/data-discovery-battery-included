<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- writers -->
        <service id="Elio\ElioBatteryIncludedSearchExtension\Core\Export\Writer\BatteryIncludedWriter">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="elio-ff.export.writer"/>
        </service>

        <!-- generators / product -->
        <service id="Elio\ElioBatteryIncludedSearchExtension\Core\Export\Generator\BatteryIncluded\ProductExportGenerator">
            <argument type="service" id="product.repository" />
            <argument type="service" id="event_dispatcher" />
            <argument type="service" id="sales_channel.repository" />
            <argument type="service" id="Elio\ElioSearch\Core\Features\FeatureService" />
            <tag name="elio-ff.export.generator" />
        </service>
    </services>
</container>
