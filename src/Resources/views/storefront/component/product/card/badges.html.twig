{% sw_extends '@Storefront/storefront/component/product/card/badges.html.twig' %}

{% block component_product_badges_new %}
    {{ parent() }}
    {% if product.extensions.record.model.document._ai.pick is defined %}
        {% set ai_pick_badge = product.extensions.record.model.document._ai.pick %}
        {% block component_product_badges_ai %}
            <div>
                <span class="badge {% if ai_pick_badge.name == 'bestseller' %}bg-success{% elseif ai_pick_badge.name == 'tip' %}bg-info{% endif %} badge-ai">
                    {% if ai_pick_badge.name == 'bestseller' %}
                        {{ 'elioBatteryIncluded.listing.badges.bestseller'|trans|sw_sanitize }}
                    {% elseif ai_pick_badge.name == 'tip' %}
                        {{ 'elioBatteryIncluded.listing.badges.tip'|trans|sw_sanitize }}
                    {% endif %}
                </span>
            </div>
        {% endblock %}
    {% endif %}
{% endblock %}