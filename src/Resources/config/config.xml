<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/platform/trunk/src/Core/System/SystemConfig/Schema/config.xsd">

    <card>
        <title>BatteryIncluded configuration</title>
        <title lang="de-DE">BatterieInklusive Konfiguration</title>

        <input-field>
            <name>apiUrl</name>
            <required>true</required>
            <label>BatteryIncluded api url</label>
            <label lang="de-DE">BatteryIncluded api url</label>
        </input-field>

        <input-field>
            <name>collection</name>
            <required>true</required>
            <label>BatteryIncluded collection</label>
            <label lang="de-DE">BatterieInbegriffene Sammlung</label>
        </input-field>

        <input-field>
            <name>browserApiKey</name>
            <required>true</required>
            <label>Browser Api Key</label>
            <label lang="de-DE">Browser Api Schlüssel</label>
        </input-field>

        <input-field>
            <name>serverApiKey</name>
            <required>true</required>
            <label>Server Api Key</label>
            <label lang="de-DE">Server Api Schlüssel</label>
        </input-field>

        <input-field type="int">
            <name>apiTimeout</name>
            <label>Api timeout</label>
            <label lang="de-DE">Api-Zeitüberschreitung</label>
        </input-field>
    </card>

    <card>
        <title>Facet configuration</title>
        <title lang="de-DE">Facet Konfiguration</title>

        <component name="sw-textarea-field">
            <name>facetLabels</name>
            <label>Labels for Facet Names</label>
            <label lang="de-DE">Labels für Facets</label>
            <placeholder>_i18n.de.categories:Kategorien|_i18n.en.categories:Categories</placeholder>
            <helpText>With this configuration labels can be set for facets: _i18n.de.categories:Kategorien|_i18n.en.categories:Categories|...</helpText>
            <helpText lang="de-DE">Mit dieser Konfiguration können Label für Facets gesetzt werden: _i18n.de.categories:Kategorien|_i18n.en.categories:Categories|...</helpText>
        </component>
    </card>

    <card>
        <title>Sorting configuration</title>
        <title lang="de-DE">Konfiguration der Sortierung</title>

        <component name="sw-textarea-field">
            <name>sortingLabels</name>
            <label>Labels for sorting</label>
            <label lang="de-DE">Etiketten zum Sortieren</label>
            <placeholder>_i18n.de.name:desc:Name des Produkts|_i18n.en.name:desc:Product name</placeholder>
            <helpText>With this configuration labels can be set for sorting: _i18n.de.name:desc:Name des Produkts|_i18n.en.name:desc:Product name|...</helpText>
            <helpText lang="de-DE">Mit dieser Konfiguration können Labels für die Sortierung gesetzt werden: _i18n.de.categories:Kategorien|_i18n.en.categories:Categories|...</helpText>
        </component>
    </card>
</config>
